# ============================================================
# AI-Based Smart Attendance System - Environment Variables
# ============================================================
# Copy values from here into Render / Vercel / Neon dashboards.
# This file documents the variables only - never put real secrets here.

# ------------------------------------------------------------
# BACKEND (Spring Boot Web Service on Render)
# ------------------------------------------------------------
# Postgres/Neon JDBC URL (use the jdbc:postgresql:// form, NOT postgresql://)
DB_URL=jdbc:postgresql://<neon-host>.neon.tech/neondb?sslmode=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>
# Any long random string (used to sign JWTs)
JWT_SECRET=<random-secret-string>
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://<frontend-url-1>,https://<frontend-url-2>

# ------------------------------------------------------------
# FRONTEND (React/Vite static site on Render and Vercel)
# ------------------------------------------------------------
# Public URL of the backend, set at build time (no trailing slash)
VITE_API_BASE=https://<backend-url>.onrender.com
